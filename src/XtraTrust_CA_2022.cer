$(document).ready(function() {
    $("body").on("contextmenu",function(){
       return false;
    }); 

    $('a,button').click(function(event) 
    {
        var end = new Date();
        var url = $(this).attr('href');
        var text = $(this).text();
        var ra_id = 'N/A';
        var role = 'Subscriber';
        if (!url || url === '#' || url === 'assets/#' || url.startsWith('javascript:')) 
        {
            return;
        }
        if(isValidUrl(url)===true) 
        {
            $.ajax({
            type: 'POST',
            data: {url: url,text: text,ra_id: ra_id,role: role},
            async: true,
            url: "https://xtratrust.com/Website/addUserActivity",
            success: function(data) {}
            });
        }
        if(SessionType=='DSC')
        {
            var str = 'MTI0VFpXeU9KUUN4eWdHT1pUeHFFd1V4RzU2dUpaOGx3cUdpaHB6U0xqSUlSeHB4clVIbXRjR1lQay9LbkdOemZQVExkTjN2NzJEbzZsdlQ5eWdpd0E9PQ==';
            $.ajax({
            type: "POST",
            url: "https://xtratrust.com/Website/UpdateDSCSession",
            data: {str: str},
            dataType: 'json',
            success: function(data) 
            { 
                if(data.status=='false')
                {
                    window.location='https://xtratrust.com/website/DSCSessionTimeout';
                }  
            }
            });
        }
    });

    $("form").submit(function(event) 
    {
        var url = $(location).attr('href'),
        parts = url.split("/"),
        last_part = parts[parts.length - 1];
        var lastChar = last_part[last_part.length - 1];
        if (lastChar == "=") 
        {
            last_part = parts[parts.length - 2];
        }
        var text = last_part;
        if($('.inner-heading h2').text()!='')
        {
            text=$('.inner-heading h2').text();
        }
        var ra_id = 'N/A';
        var role = 'Subscriber';
        if(!url || url === '#' || url === 'assets/#' || url.startsWith('javascript:')) 
        {
            return;
        }
        if(isValidUrl(url)===true)
        {
            $.post("https://xtratrust.com/website/addUserActivity", {
            url: url,
            text: text,
            ra_id: ra_id,
            role: role
            }, function(data) {});
        }
    });

    const isValidUrl = urlString=> 
    {
        let url;
        try 
        { 
            url =new URL(urlString); 
        }
        catch(e)
        { 
            return false; 
        }
        return url.protocol === "http:" || url.protocol === "https:";
    }

}); 

