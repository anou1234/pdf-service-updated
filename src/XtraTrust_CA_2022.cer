/*before live css add*/


/* Modal animation */
.modal.fade.todaylive--pop .modal-dialog {
    transform: scale(0.8);
    opacity: 0;
    transition: all 0.4s ease;
}
.modal.fade.todaylive--pop.show .modal-dialog {
    transform: scale(1);
    opacity: 1;
}

/* Modal */
.todaylive--pop .custom-modal {
    border-radius: 20px;
    overflow: hidden;
    border: none;
}

/* Header (Premium Blue Gradient + Pattern) */
.todaylive--pop .modal-header {
        background: #E0EAFC;  /* fallback for old browsers */
background: -webkit-linear-gradient(to right, #CFDEF3, #E0EAFC);  /* Chrome 10-25, Safari 5.1-6 */
background: linear-gradient(to right, #CFDEF3, #E0EAFC); /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */

    color: #fff;
    text-align: center;
    display: block;
    padding: 14px 20px;
    position: relative;
    overflow: hidden;
}

/* Pattern overlay */
.todaylive--pop .modal-header::before {
    content: "";
    position: absolute;
    width: 200%;
    height: 200%;
    top: -50%;
    left: -50%;
    background-image: radial-gradient(rgba(255,255,255,0.08) 2px, transparent 2px);
    background-size: 40px 40px;
    animation: movePattern 20s linear infinite;
}

@keyframes movePattern {
    from { transform: translate(0,0); }
    to { transform: translate(50px,50px); }
}

/* Keep content above pattern */
.todaylive--pop .modal-header * {
    position: relative;
    z-index: 2;
        color: #01358D;
        font-weight: 700;
    font-size: 1.6rem;
    padding: 0px;
	margin-top:2px
}

/* Logo */
.logo-img {
    max-width: 123px;
    margin-bottom: 7px;
}

/* Highlight */
.todaylive--pop .highlight {
    color: #F9556D;
    font-style: italic;
}

/* Body */
.todaylive--pop .modal-body {
        padding: 10px 20px 5px;
    background: #ffffff;
    font-size: 15px;
    line-height: 1.6;
}

.todaylive--pop .note {
    color: #2a5298;
    font-style: italic;
}

/* Effective box */
.todaylive--pop .effective-box {
  background: #01358D;
    color: #fff;
    padding: 10px 20px;
    display: inline-block;
    font-weight: 600;
    margin: 3px 0;
    border-radius: 6px;
}

.todaylive--pop .modal-body p
{
  margin-bottom:7px
}
/* Footer */
.todaylive--pop .modal-footer {
    background: #eaf1ff;
    justify-content: center;
    border-top: none;
}

.todaylive--pop .btn-custom {
    background: #01358D;
    color: #fff;
    border-radius: 20px;
    padding: 8px 25px;
    border: none;
}

.todaylive--pop .btn-custom:hover {
    background: #1e3c72;
}

/* Fireworks canvas */
#fireworks {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
}

/*After Live*/
/* Modal animation */
.modal.fade.poplive02 .modal-dialog {
    transform: scale(0.8);
    opacity: 0;
    transition: all 0.4s ease;
}
.modal.fade.poplive02.show .modal-dialog {
    transform: scale(1);
    opacity: 1;
}

/* Modal */
.poplive02 .premium-modal {
    border-radius: 20px;
    overflow: hidden;
    border: none;
}

/* 🔴 HEADER GRADIENT */
.poplive02 .premium-header {
    background: linear-gradient(135deg, #ff6a6a, #8b0000);
    color: white;
    text-align: center;
    padding: 15px 15px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* Pattern */
.poplive02 .premium-header::before {
    content: "";
    position: absolute;
    width: 200%;
    height: 200%;
    top: -50%;
    left: -50%;
    background-image: radial-gradient(rgba(255,255,255,0.08) 2px, transparent 2px);
    background-size: 40px 40px;
    animation: movePattern 20s linear infinite;
}

@keyframes movePattern {
    from { transform: translate(0,0); }
    to { transform: translate(50px,50px); }
}

/* Content above pattern */
.poplive02 .premium-header * {
    position: relative;
    z-index: 2;
}

/* 🔥 LOGO FIX */
.logo-img {
    max-width: 140px;
    margin-bottom: 10px;
    background: rgba(255, 255, 255, 0.9);
    padding: 8px 12px;
    border-radius: 10px;
}

/* Ribbon */
.poplive02 .ribbon {
   display: inline-block;
    border: 1px solid #f5c542;
    color: #f5c542;
    padding: 7px 15px;
    font-size: 13px;
    letter-spacing: 2px;
    margin-bottom: 4px;
    font-weight: 600;
}

/* Header Text */
.poplive02 .premium-header h1 {
    font-weight: 700;
    margin: 0;
    color: #fff;
    font-size: 30px;
}

.poplive02 .premium-header img
{
  width: 120px;
}

.poplive02 .premium-header span {
    color: #ffd36b;
    font-style: italic;
}

/* Body */
.poplive02 .premium-body {
    background: #f7f1ea;
    padding: 10px 15px;
    font-size: 15px;
}

.poplive02 .premium-body p
{
  margin-bottom:5px
}

.poplive02 .premium-body h5 {
    font-weight: 700;
    margin-bottom: 5px;
    font-size: 1.15rem;
}

/* Highlight box */
.poplive02 .highlight-box {
    background: #ffffff;
    padding: 12px;
    border-left: 4px solid #f5c542;
    margin: 5px 0;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        font-size: 15px;
}

.poplive02 .highlight-box b {
    color: #1f2f4a;
}

.poplive02 .highlight-red {
    color: #8b1e2d;
    font-weight: 600;
    font-size: 16px;
}

/* 🔥 BLINK ANIMATION */
@keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0; }
    100% { opacity: 1; }
}

.blink {
    animation: blink 1s infinite;
}

/* Footer */
.poplive02 .premium-footer {
    background: #1f2f4a;
    text-align: center;
    padding: 12px;
}

.poplive02 .btn-ok {
    color: #f5c542;
    background: transparent;
    border: none;
}

.poplive02 .btn-ok:hover {
    text-decoration: underline;
}

/* Fireworks */
#fireworks {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
}

.highlight-box {
    background: rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.3);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);

    padding: 18px;
    margin: 20px 0;

    /* Slide animation */
    transform: translateY(40px);
    opacity: 0;
    animation: slideGlass 0.8s ease forwards;
}

/* Animation */
@keyframes slideGlass {
    0% {
        transform: translateY(40px);
        opacity: 0;
    }
    100% {
        transform: translateY(0);
        opacity: 1;
    }
}
</style>

