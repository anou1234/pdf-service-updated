.time--logout--sec .material-symbols-outlined,.time--logout--sec_ad .material-symbols-outlined {
  visibility: hidden;
  line-height: 36px;
}

.fonts-loaded .material-symbols-outlined {
  visibility: visible;
}

.time--logout--sec {
    display: flex;
    position: absolute;
    text-align: center;
    align-items: center;
    gap: 5px;
    right: 0;
    top: 20px;
}

.time--logout--sec span {
    font-size: 13px;
    color: #0b355a;
    font-weight: 500;
    padding: 0px;
    width: 150px;
}

.time--logout--sec a {
   height: 35px;
    padding: 1px 10px;
    display: block;
    border-radius: 20px;
    background: #FE6666;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    display: none;
    line-height: 30px;
}

.time--logout--sec_ad {
    z-index: 99;
    position: absolute;
    top: 20px;
    display: flex;
    /* flex-direction: column; */
    align-items: center;
    right: 0;
    gap: 5px;
}

.time--logout--sec_ad span {
    font-size: 13px;
    color: #0b355a;
    font-weight: 500;
    padding: 0px;
    width: 205px;
}

.time--logout--sec_ad a {
    height: 35px;
    padding: 1px 10px;
    border-radius: 20px;
    background: #d84635;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    display:none;
    line-height:30px
}

.session-timeout
