}

.single-box a {
    text-decoration: none;
}

/* Initial State */
.animated-dropdown {
  opacity: 0;
  transform: translateY(10px);
  transition: all 0.3s ease;
  display: block !important; /* prevent flicker */
  visibility: hidden;
  pointer-events: none;
}

/* Show State (Bootstrap 5 adds 'show' class on dropdown) */
.dropdown-menu.show.animated-dropdown {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
  pointer-events: auto;
}



