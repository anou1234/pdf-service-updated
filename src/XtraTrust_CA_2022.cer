    }
});

$('#tmobile').on('input', function() {
    var mobile = $("#tmobile").val();
    if (mobile == "") {
        $("#mobile_error").show();
        return false;
    } else {
        if (mobile.length != 10) {
            $('#mobile_error').show();
            $("#mobile_error").html("Required 10 digits");
            return false;
        } else {
            $("#mobile_error").hide();
        }

    }
});

$('#temail').on('input', function() {
    var email = $("#temail").val();
    if (email == "") {
        $("#email_error").show();
        return false;
    } else {

        var alphaExp = /^(([^<>()\[\]\\.,;:*#!$&^=+\s@"]+(\.[^<>()\[\]\\.,;:*#!$&^=+\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        if (email.match(alphaExp)) {
            $('#email_error').hide();
        } else {
            $('#email_error').show();
            $("#email_error").html("Please Enter Valid Email ");
            return false;
        }
    }
});


function validateSupportForm() {

    //aler(window.location.pathname);
    var formData = new FormData($("#supportTicketForm")[0])   
    var name = $("#tname").val();
    var subject = $("#tsubject").val();
    var description = $("#tdescription").val();
    var email = $("#temail").val();
    var mobile = $("#tmobile").val();
    var modules = $("#module").val();
    var ticlet_type = $("#ticlet_typediv").val();
    if (name == "") {
        $("#name_error").show();
        return false;
    } else {
        $("#name_error").hide();
    }

    if (email == "") {
        $("#email_error").show();
        return false;
    } else {

        var alphaExp = /^(([^<>()\[\]\\.,;:*#!$&^=+\s@"]+(\.[^<>()\[\]\\.,;:*#!$&^=+\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        if (email.match(alphaExp)) {
            $('#email_error').hide();
        } else {
            $('#email_error').show();
            $("#email_error").html("Please Enter Valid Email ");
            return false;
        }
    }

    if (mobile == "") {
        $("#mobile_error").show();
        return false;
    } else {
        if (mobile.length != 10) {
            $('#mobile_error').show();
            $("#mobile_error").html("Required 10 digits");
            return false;
        } else {
            $("#mobile_error").hide();
        }

    }
    if (subject == "") {
        $("#subject_error").show();
        return false;
    } else {
        $("#subject_error").hide();
    }
        if (modules== "") {
        $("#module_error").show();
        return false;
    } else {
        $("#module_error").hide();
    }
    
    if (ticlet_type == "" || ticlet_type == null  || ticlet_type == undefined ) {
        $("#ticlet_type_error").show();
        return false;
    } else {
        $("#ticlet_type_error").hide();
    }
    if (description == "") {
        $("#description_error").show();
        return false;
    } else {
        $("#description_error").hide();
    }

    $.ajax({

        type: 'POST',
        data: formData,
        async: true,
        url: "https://xtratrust.com/Website/reiseTicket",

        beforeSend: function() {                
            $("#supportSubmitBtn").attr("disabled", true);
            
            $('#supportSubmitArea1').hide();
            $('#supportSubmitArea2').show();
            //$('#pageloaddiv').css("display", "block");
        },
        success: function(data) {
            var obj=JSON.parse(data);
            if(obj.success=='1'){
                $('#supportTicketForm')[0].reset();
                toastr.success("Your request has been successfully saved.");
                location.reload();
            }
            //$('#pageloaddiv').css("display", "none");
            //$(".formfooter").hide();
            //$(".formbody").hide();
            //$(".thankyou").show();
        },
        cache: false,
        contentType: false,
        processData: false
    });

}

