<script>

var MobileVerified=0;

    function Initiatcounter(timelimit)
    {
        var t = this;
        this.timeLeftForSubmission = timelimit;
        var a = Math.floor(t.timeLeftForSubmission / 60);
        var html="Session Time: "+ a + "m " + (t.timeLeftForSubmission - 60 * a)+ "s ";
        document.querySelector(".time--logout--sec a").style.display='block';
        document.getElementById("dsccountdown").innerHTML =html;
        clearInterval(this.submissionInterval);
        this.submissionInterval = setInterval(function() 
        {
            if(t.timeLeftForSubmission>0)
            {
                t.timeLeftForSubmission--;
                a = Math.floor(t.timeLeftForSubmission / 60);
                html="Session Time: "+ a + "m " + (t.timeLeftForSubmission - 60 * a)+ "s ";
                document.querySelector(".time--logout--sec a").style.display='block';
                document.getElementById("dsccountdown").innerHTML =html;
                MobileVerified=1;
            }
            else
            {
                clearInterval(this.submissionInterval);
                toastr.error('Your DSC Session is expired.'); 
                MobileVerified=0;
                setTimeout(function(){window.location.href ='https://xtratrust.com/kyc/CreateKYC/dsctimeout'; },2000);
            }
        }, 1e3);
    }
var submissionInterval1 = '';
function Initiatcounter_aadhar(timelimit)
{
    var t = this;
    this.timeLeftForSubmission1 = timelimit;
    var a = Math.floor(t.timeLeftForSubmission1 / 60);
    var html="Aadhaar Session Time: "+ a + "m " + (t.timeLeftForSubmission1 - 60 * a)+ "s ";
    document.querySelector(".time--logout--sec_ad a").style.display='block';
    document.getElementById("dsccountdown_aadhar").innerHTML =html;
    clearInterval(this.submissionInterval1);
    this.submissionInterval1 = setInterval(function() 
    {
        if(t.timeLeftForSubmission1>0)
        {
            t.timeLeftForSubmission1--;
            a = Math.floor(t.timeLeftForSubmission1 / 60);
            html="Aadhaar Session Time: "+ a + "m " + (t.timeLeftForSubmission1 - 60 * a)+ "s ";
            document.querySelector(".time--logout--sec_ad a").style.display='block';
            document.getElementById("dsccountdown_aadhar").innerHTML =html;
        }
        else
        {
            clearInterval(this.submissionInterval1);
            toastr.error('Aadhaar match Session is expired.'); 
            setTimeout(function(){window.location.href ='https://xtratrust.com/kyc/CreateKYC/dsctimeout'; },2000);
        }
    }, 1e3);
}


</script>   
