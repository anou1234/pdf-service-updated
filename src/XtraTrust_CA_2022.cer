var audio_;
function playaudio(ab,src) {
    if(audio_)
    {
      
      $(".volup").removeClass('fa fa-volume-up');
      $(".volup").addClass('fa fa-volume-down'); 
      $(".volup").css({"font-size":"13px","color":"#333"});  
      audio_.pause();      
    }
    const audio = audio_ = new Audio(src);
    audio.play();
    // console.log('dfd',ab);
    $(ab).removeClass('fa fa-volume-down'); 
    $(ab).addClass('fa fa-volume-up volup');
    $(ab).css({"font-size":"16px","color":"#333"}); 
}
 
