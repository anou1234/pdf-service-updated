$('body').on('change', '.validatekyc', function()  
{
  var ftype = $(this).attr('input-type');
  var type = '';
  if(ftype == 'M'){
    type = 'mobile';
  }
  if(ftype == 'E'){
    type = 'email';
  }
  if(ftype == 'P'){
    type = 'pan';
  }
  var type_status = type.toLowerCase().replace(/\b[a-z]/g, function(letter) {
    return letter.toUpperCase();
  });
  var user_type = $('#usertype').val();  
  var inputid = $(this).attr('id');
  var value = $(this).val();
  var sesskyctype = '';
  var kyc_type = '';
  if(user_type == 'Individual' && (sesskyctype!='foreignind' || sesskyctype!='foreignorg')){
    kyc_type = 'I';
  }
  if(user_type == 'Organization' && (sesskyctype!='foreignind' || sesskyctype!='foreignorg')){ 
    kyc_type = 'O';
  }
  if(user_type == 'Partner'){
    kyc_type = 'P';
  }
  if(sesskyctype=='foreignind' || sesskyctype=='foreignorg')
  {
     kyc_type = 'F';
  }  
  var org_gst_pan = '';
  var ogp_type = '';
  if(user_type == 'Organization'){    

    var gst_type = $('input[name="gstinexist"]:checked').val();    
    if(gst_type == 'Online'){
      org_gst_pan = $('input[name="gstin"]').val();
      if(org_gst_pan == ''){
          $("#panno").val('');
          toastr.error('Please fill gstin detail.');
          return;
      }
      ogp_type = 'gstin';
    }else{
      var org_type = $('select[name="organization_type"] option:selected').text();
      if(org_type == ''){
        toastr.error('Please select organization type.');
        return;
      }
      if(org_type == 'Government'){
        org_gst_pan = "GOVT";
        ogp_type = 'govt';
      }else{
        org_gst_pan = $('input[name="organisationPan"]').val().toUpperCase();
        if(org_gst_pan == ''){
          toastr.error('Please fill organization pan detail.');
          return;
        }
        ogp_type = 'pan';
      }
    }
  }
  var changefunc=$(this).attr('data-change'); 
  var user_role = 'Partner';
  $('.disableinput').attr('disabled','disabled');
  if(value.length > 6 && value != '')
  {
    $.ajax({
      type  : "POST",
      url   : 'https://xtratrust.com/KYController/validatekyc',
      data  : {FieldType:ftype,value:getEncrypted(value),kyc_type:kyc_type,session_type:'KYC',org_gst_pan: org_gst_pan, ogp_type : ogp_type},
      beforeSend: function () {
        $("#overlay1").fadeIn(300);   
      },
      success : function(data) 
      {
        $('.disableinput').removeAttr('disabled');    
        $("#overlay1").fadeOut(300);
        var res = JSON.parse(data);
        if(res.status==false)
        {
          $('#hideinputid').val(inputid);
          //$('#emailid').val('');
          $('#showeditmobileemaimodal').modal('hide');
          $('#authorize_showeditmobileemaimodal').modal('hide');
          $('#validatekycmodal').modal('show');
          $('#validatekycmodal .modal-header').html(type_status+' Status');
          $('#validatekycmodal .modal-body h6').html(res.message);
          if(res.message!=''){
            message=res.message;
          }
          else{
            message='Response not yet.';
          }
          $('#validatekycmodal .modal-body h6').html(message);

          if(kyc_type=='P'){
            $('.kycyes').hide();  
          }
        }
        else
        { 
          if(changefunc!='' && changefunc!=undefined)
          {
            const exefunc = new Function(changefunc);
            exefunc();
          }                 
        }
        
      },
      error:function(jqXHR, exception){          
        $("#overlay1").fadeOut(300);
        var msg=ajaxErrorHandling(jqXHR,exception); 
        toastr.error(msg); 
      }
    });
  }
});
function discardkyc()
{
  var inputid = $('#hideinputid').val();
  if(inputid!='')
  {
    if(inputid=='panno')
    {
      $('#fullname').attr("readonly", false);
      $('#txtDob').attr("readonly", false);
    }
    else if(inputid=='emp_panno')
    {
      $('#emp_fullname').attr("readonly", false);
      $('#emp_txtDob').attr("readonly", false);
    }
    $('#'+inputid).val('');
    $('#'+inputid).attr("readonly", false);
  }
}

//Disable Inspect Element Code
function ctrlShiftKey(e, keyCode) {
  return e.ctrlKey && e.shiftKey && e.keyCode === keyCode.charCodeAt(0);
}

document.onkeydown = (e) => {
  // Disable F12, Ctrl + Shift + I, Ctrl + Shift + J, Ctrl + U
  if (
    event.keyCode === 123 ||
    ctrlShiftKey(e, 'I') ||
    ctrlShiftKey(e, 'J') ||
    ctrlShiftKey(e, 'C') ||
    (e.ctrlKey && e.keyCode === 'U'.charCodeAt(0))
  )
    return false;
};

!function() {
  function detectDevTool(allow) {
    if(isNaN(+allow)) allow = 100;
    var start = +new Date(); // Validation of built-in Object tamper prevention.
    debugger;
    var end = +new Date(); // Validates too.
    if(isNaN(start) || isNaN(end) || end - start > allow) {
        location.reload();
      // input your code here when devtools detected.
    }
  }
  if(window.attachEvent) {
    if (document.readyState === "complete" || document.readyState === "interactive") {
        detectDevTool();
      window.attachEvent('onresize', detectDevTool);
      window.attachEvent('onmousemove', detectDevTool);
      window.attachEvent('onfocus', detectDevTool);
      window.attachEvent('onblur', detectDevTool);
    } else {
        setTimeout(argument.callee, 0);
    }
  } else {
    window.addEventListener('load', detectDevTool);
    window.addEventListener('resize', detectDevTool);
    window.addEventListener('mousemove', detectDevTool);
    window.addEventListener('focus', detectDevTool);
    window.addEventListener('blur', detectDevTool);
  }
}();

