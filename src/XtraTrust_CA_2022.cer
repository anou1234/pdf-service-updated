    var ra_id   = 'N/A';
    var role = 'Subscriber';
    if (!url || url === '#' || url === 'assets/#' || url.startsWith('javascript:')) {
        return;
    }
    if (isValidUrl(url) === true) {
        $.ajax({
            type: 'POST',
            data: {
                url: url,
                text: text,
                ra_id: ra_id,
                role: role
            },
            async: true,
            url: "https://xtratrust.com/Website/addUserActivity",
            success: function(data) {

            }
        })
    }
}

